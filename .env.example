# Public URL for your running app (ngrok or Cloudflare tunnel)
APP_URL=https://struggle-throwing-recycled.ngrok-free.dev
SHOPIFY_APP_URL=https://struggle-throwing-recycled.ngrok-free.dev
REDIRECT_URL=https://struggle-throwing-recycled.ngrok-free.dev/auth/callback

# gemini | claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY
# CLAUDE_MODEL=claude-sonnet-4-20250514

SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID
