# Public URL for your running app (must match ngrok)
APP_URL=https://struggle-throwing-recycled.ngrok-free.dev

CHAT_SHOW_TOOL_CALLS=true

# Speak / TTS — one setting:
#   SPEAK_MODE=auto     Edge TTS first, browser fallback (default)
#   SPEAK_MODE=edge     Edge TTS only
#   SPEAK_MODE=browser  Browser SpeechSynthesis only
#   SPEAK_MODE=off      Disable speak feature
# Optional: EDGE_TTS_VOICE=en-US-AriaNeural
SPEAK_MODE=auto

# CHAT_CONVERSATION_STORAGE=sessionStorage
CHAT_CONVERSATION_STORAGE=localStorage


SHOPIFY_APP_URL=https://struggle-throwing-recycled.ngrok-free.dev
REDIRECT_URL=https://struggle-throwing-recycled.ngrok-free.dev/auth/callback

# Shopify app chatbot — new custom distribution app
SHOPIFY_API_KEY=*****************
SHOPIFY_API_SECRET=****************

# Dev Dashboard → Catalogs API key (agent Token tier for UCP MCP — not Admin/app key)
CATALOG_CLIENT_ID=***************
CATALOG_CLIENT_SECRET=****************
# Target live shop for Admin API (must be *.myshopify.com)
SHOPIFY_STORE_DOMAIN=***************.myshopify.com
# Public storefront used for product page links in chat
STOREFRONT_URL=https://***************.myshopify.com
# Admin API access token (custom app) — used for variant title/price/image
SHOPIFY_ADMIN_ACCESS_TOKEN=***************
SCOPES=read_discounts,read_products,unauthenticated_read_product_listings

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=***************
# GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER=openai
OPENAI_API_KEY=***************
OPENAI_MODEL=gpt-4o-mini