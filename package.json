{
  "name": "shop-chat-agent",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-app-url.mjs",
    "dev": "npm run predev && shopify app dev",
    "dev:localhost": "npm run predev && shopify app dev --use-localhost",
    "dev:server": "npm run predev && react-router dev --port 3000",
    "build": "react-router build",
    "deploy": "npm run predev && shopify app deploy",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node ./scripts/production-serve.mjs ./build/server/index.js",
    "sync:blogs": "node scripts/sync-blogs.js",
    "sync:pages": "node scripts/sync-pages.js",
    "sync:policies": "node scripts/sync-policies.js",
    "sync:products": "node scripts/sync-products.js",
    "embed:products": "node scripts/embed-products.js",
    "query:log": "node scripts/generate-queries-from-log.js",
    "search:summer": "node scripts/search-summer-perfume.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@google/genai": "^1.52.0",
    "@prisma/client": "^6.2.1",
    "@react-router/dev": "^7.9.1",
    "@react-router/fs-routes": "^7.9.1",
    "@react-router/node": "^7.9.1",
    "@react-router/serve": "^7.9.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/shopify-app-react-router": "^1.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^7.0.0",
    "dotenv": "^16.3.1",
    "isbot": "^5.1.0",
    "mammoth": "^1.13.0",
    "msedge-tts": "^2.0.7",
    "mysql2": "^3.23.3",
    "openai": "^7.5.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.9.1",
    "vite-tsconfig-paths": "^5.0.1",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.1.1",
    "@shopify/polaris-types": "^1.0.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.4",
    "typescript": "^5.2.2",
    "vite": "^6.2.2"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5"
  },
  "author": "siddhantbajaj"
}
