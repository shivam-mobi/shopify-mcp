<link rel="stylesheet" href="{{ 'chat.css' | asset_url }}?v=speak-config-2">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

{% assign brand_color = block.settings.chat_bubble_color | default: '#00BCF2' %}
{% if brand_color == '#5046e4' or brand_color == '#5046E4' %}
  {% assign brand_color = '#00BCF2' %}
{% endif %}
{% assign assistant_name = block.settings.assistant_name | default: 'AIRA' %}
{% assign assistant_display = assistant_name | downcase | capitalize %}
{% if assistant_display == blank %}
  {% assign assistant_display = 'Aira' %}
{% endif %}

<div
  class="shop-ai-chat-container"
  data-shop-ai-assets="dori-redesign-1"
  style="--shop-ai-brand: {{ brand_color }};"
>
  <!-- Floating launcher -->
  <button type="button" class="shop-ai-chat-bubble" aria-label="{{ 'chat.openButton' | t }}">
    <svg class="shop-ai-sparkle-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2l1.8 5.4L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.6L12 2z" fill="currentColor" opacity="0.95"/>
      <path d="M18 14l0.9 2.7L21.5 18l-2.6 0.9L18 21.5l-0.9-2.6L14.5 18l2.6-0.9L18 14z" fill="currentColor" opacity="0.7"/>
      <path d="M6 13l0.7 2.1L8.8 16l-2.1 0.7L6 18.8 5.3 16.7 3.2 16l2.1-0.7L6 13z" fill="currentColor" opacity="0.7"/>
    </svg>
  </button>

  <div class="shop-ai-bubble-callout" hidden>
    <button
      type="button"
      class="shop-ai-bubble-callout-dismiss"
      aria-label="{{ 'chat.calloutDismiss' | t }}"
    >×</button>
    <button type="button" class="shop-ai-bubble-callout-body">
      <span class="shop-ai-bubble-callout-wave" aria-hidden="true">👋</span>
      <span class="shop-ai-bubble-callout-text" data-callout-text></span>
    </button>
  </div>

  <div class="shop-ai-chat-window">
    <!-- Header -->
    <div class="shop-ai-chat-header">
      <div class="shop-ai-chat-header-brand">
        <div class="shop-ai-header-identity">
          <strong class="shop-ai-header-name">{{ assistant_display }}</strong>
          <span class="shop-ai-header-tagline">{{ 'chat.headerTagline' | t }}</span>
        </div>
      </div>
      <div class="shop-ai-chat-header-actions">
        <button type="button" class="shop-ai-home-btn shop-ai-has-tip" aria-label="{{ 'chat.newChat' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.375 2.625a1 1 0 0 1 1.414 0l2.586 2.586a1 1 0 0 1 0 1.414L13 15.414 9 16l.586-4L18.375 2.625z"/>
          </svg>
          <span class="shop-ai-tip" role="tooltip">{{ 'chat.newChat' | t }}</span>
        </button>
        <button
          type="button"
          class="shop-ai-chat-expand shop-ai-has-tip"
          aria-label="{{ 'chat.expandButton' | t }}"
        >
          <svg class="shop-ai-chat-expand-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <svg class="shop-ai-chat-collapse-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 14 10 14 10 20"></polyline>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="14" y1="10" x2="21" y2="3"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <span class="shop-ai-tip" role="tooltip">{{ 'chat.expandButton' | t }}</span>
        </button>
        <button
          type="button"
          class="shop-ai-chat-close shop-ai-has-tip"
          aria-label="{{ 'chat.closeButton' | t }}"
        >
          ✕
          <span class="shop-ai-tip" role="tooltip">{{ 'chat.closeButton' | t }}</span>
        </button>
      </div>
    </div>

    <!-- Home view -->
    <div class="shop-ai-home-view">
      <div class="shop-ai-home-hero">
        <h2 class="shop-ai-greeting" data-greeting-target></h2>
        <p class="shop-ai-greeting-sub" data-greeting-sub-target>{{ 'chat.greetingSubtitle' | t }}</p>
      </div>

      <div class="shop-ai-suggestions">
        {% assign suggestions_raw = block.settings.suggestions | default: "Find the right cabin air filter for my vehicle\nCompare HEPA vs standard filters\nWhat filter fits my car?\nHelp me choose the best filter" %}
        {% assign suggestions = suggestions_raw | newline_to_br | split: '<br />' %}
        {% for suggestion in suggestions %}
          {% assign text = suggestion | strip %}
          {% if text != blank %}
            <button type="button" class="shop-ai-suggestion-chip{% if forloop.first %} is-featured{% endif %}" data-suggestion="{{ text | escape }}">
              <svg class="shop-ai-chip-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="1 4 1 10 7 10"/>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
              </svg>
              <span>{{ text }}</span>
            </button>
          {% endif %}
        {% endfor %}
      </div>

      <div class="shop-ai-sessions-section">
        <div class="shop-ai-sessions-header">
          <h3 class="shop-ai-sessions-title">{{ 'chat.recentChats' | t }}</h3>
        </div>
        <div class="shop-ai-sessions-list">
          <!-- Sessions injected by JS -->
        </div>
      </div>
    </div>

    <!-- Chat view -->
    <div class="shop-ai-chat-view" hidden>
      <div class="shop-ai-chat-messages">
        <!-- Messages added by JavaScript -->
      </div>
    </div>

    <!-- Input bar -->
    <div class="shop-ai-chat-input">
      <div class="shop-ai-input-row">
        <div class="shop-ai-input-wrap">
          <svg class="shop-ai-input-sparkle" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2l1.8 5.4L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.6L12 2z" fill="currentColor"/>
            <path d="M18 14l0.9 2.7L21.5 18l-2.6 0.9L18 21.5l-0.9-2.6L14.5 18l2.6-0.9L18 14z" fill="currentColor" opacity="0.6"/>
          </svg>
          <textarea
            class="shop-ai-chat-input-field"
            placeholder="{{ 'chat.inputPlaceholder' | t }}"
            autocomplete="off"
          ></textarea>
          <button
            type="button"
            class="shop-ai-voice-btn"
            aria-label="{{ 'chat.voiceStart' | t }}"
            title="{{ 'chat.voiceStart' | t }}"
            hidden
          >
            <svg class="shop-ai-voice-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
          </button>
        </div>
        <button type="button" class="shop-ai-chat-send" aria-label="{{ 'chat.sendButton' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>
      </div>
      <p class="shop-ai-voice-status" aria-live="polite" hidden></p>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}?v=speak-config-2" defer></script>
<script>
  window.shopChatConfig = {
    apiUrl: "https://struggle-throwing-recycled.ngrok-free.dev",
    storefrontUrl: {{ shop.url | json }},
    promptType: {{ block.settings.system_prompt | json }},
    welcomeMessage: {{ block.settings.welcome_message | json }},
    assistantName: {{ assistant_name | json }},
    inputPlaceholder: {{ 'chat.inputPlaceholder' | t | json }},
    expandButtonLabel: {{ 'chat.expandButton' | t | json }},
    collapseButtonLabel: {{ 'chat.collapseButton' | t | json }},
    greetingWithName: {{ 'chat.greetingWithName' | t | json }},
    greetingAnonymous: {{ 'chat.greetingAnonymous' | t | json }},
    greetingSubtitle: {{ 'chat.greetingSubtitle' | t | json }},
    noSessionsLabel: {{ 'chat.noSessions' | t | json }},
    voiceStartLabel: {{ 'chat.voiceStart' | t | json }},
    voiceStopLabel: {{ 'chat.voiceStop' | t | json }},
    voiceListeningLabel: {{ 'chat.voiceListening' | t | json }},
    voiceUnsupportedLabel: {{ 'chat.voiceUnsupported' | t | json }},
    voiceErrorLabel: {{ 'chat.voiceError' | t | json }},
    voiceNoSpeechLabel: {{ 'chat.voiceNoSpeech' | t | json }},
    voiceDeniedLabel: {{ 'chat.voiceDenied' | t | json }},
    voiceReviewLabel: {{ 'chat.voiceReview' | t | json }},
    speakStartLabel: {{ 'chat.speakStart' | t | json }},
    speakStopLabel: {{ 'chat.speakStop' | t | json }},
    copyMessageLabel: {{ 'chat.copyMessage' | t | json }},
    copyMessageDoneLabel: {{ 'chat.copyMessageDone' | t | json }},
    messageTimeJustNowLabel: {{ 'chat.messageTimeJustNow' | t | json }},
    messageTimeMinuteAgoLabel: {{ 'chat.messageTimeMinuteAgo' | t | json }},
    messageTimeMinutesAgoLabel: {{ 'chat.messageTimeMinutesAgo' | t | json }}{% if customer %},
    customerLoggedIn: true,
    customerId: {{ customer.id | json }},
    customerFirstName: {{ customer.first_name | json }},
    customerLastName: {{ customer.last_name | json }},
    customerEmail: {{ customer.email | json }},
    customerAddresses: [
      {%- for address in customer.addresses limit: 20 -%}
        {
          "id": {{ address.id | json }},
          "first_name": {{ address.first_name | json }},
          "last_name": {{ address.last_name | json }},
          "company": {{ address.company | json }},
          "street_address": {{ address.address1 | json }},
          "extended_address": {{ address.address2 | json }},
          "address_locality": {{ address.city | json }},
          "address_region": {{ address.province_code | default: address.province | json }},
          "postal_code": {{ address.zip | json }},
          "address_country": {{ address.country_code | default: address.country | json }},
          "phone_number": {{ address.phone | json }},
          "is_default": {% if customer.default_address and address.id == customer.default_address.id %}true{% else %}false{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]{% endif %}
  };
  window.shopId = {{ shop.id }};
  window.shopDomain = {{ shop.permanent_domain | json }};
</script>

{% schema %}
{
  "name": "AIRA",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Brand Color",
      "default": "#00BCF2"
    },
    {
      "type": "text",
      "id": "assistant_name",
      "label": "Assistant Name",
      "default": "AIRA"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Welcome Message",
      "default": "I can help with cabin air filters and vehicle fitment, cabin filter air fresheners, and home filters."
    },
    {
      "type": "textarea",
      "id": "suggestions",
      "label": "Suggestion chips (one per line)",
      "default": "Find the right cabin air filter for my vehicle\nCompare HEPA vs standard filters\nWhat filter fits my car?\nHelp me choose the best filter"
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "System Prompt",
      "options": [
        {
          "value": "standardAssistant",
          "label": "Standard Assistant"
        },
        {
          "value": "enthusiasticAssistant",
          "label": "Enthusiastic Assistant"
        }
      ],
      "default": "standardAssistant"
    }
  ]
}
{% endschema %}
